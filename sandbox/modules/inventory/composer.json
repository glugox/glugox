{
  "name": "glugox/inventory",
  "description": "Example inventory module",
  "type": "library",
  "require": {
    "php": "^8.1",
    "glugox/module": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Glugox\\Inventory\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Glugox\\Inventory\\InventoryServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
